# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Used by the agent itself (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used by the DeepEval judge LLM (GPT-4o)
OPENAI_API_KEY=sk-your-key-here

# Used by Langfuse tracing (create keys at https://cloud.langfuse.com)
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
